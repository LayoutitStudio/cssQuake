{
  "name": "cssquake",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "description": "A standalone CSS-rendered Quake renderer powered by PolyCSS.",
  "license": "GPL-2.0-only",
  "scripts": {
    "dev": "vite",
    "dev:trace": "vite --host 127.0.0.1 --port 5177",
    "prepare:quake": "node src/prepare/assets.mjs",
    "prepare:quake:map": "node src/prepare/target.mjs map",
    "prepare:quake:manifest": "QUAKE_PREPARE_ONLY=manifest node src/prepare/assets.mjs",
    "prepare:quake:model": "node src/prepare/target.mjs model",
    "prepare:quake-logic": "node src/prepare/quakecLogic.mjs",
    "prepare:quake-model-facts": "node src/prepare/modelRenderCostFacts.mjs",
    "deploy:upload-r2-assets": "node .github/scripts/upload-r2-assets.mjs",
    "build": "vite build",
    "build:full": "pnpm prepare:quake && vite build",
    "preview": "vite preview",
    "test": "node test/runContracts.mjs",
    "test:asset-state": "node test/assets/checkAssetState.mjs",
    "test:assets": "node test/assets/runAssetIntegrity.mjs",
    "test:browser:smoke": "node test/browser/runBrowserSmoke.mjs",
    "test:browser:multiplayer": "node test/browser/runMultiplayerBrowserSmoke.mjs",
    "test:browser": "node test/browser/runBrowserFixtures.mjs",
    "test:harness": "node test/runHarnessPlan.mjs",
    "test:perf": "node test/perf/runPerfPreflight.mjs",
    "test:dev": "pnpm test && pnpm test:perf",
    "test:all": "pnpm test && pnpm test:assets && pnpm test:browser:smoke && pnpm test:browser && pnpm test:perf"
  },
  "dependencies": {
    "@layoutit/polycss": "^0.2.6",
    "partysocket": "1.1.19"
  },
  "devDependencies": {
    "7z-bin": "^0.0.8",
    "@napi-rs/canvas": "^1.0.0",
    "@types/node": "^25.5.0",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.10.2",
    "partykit": "0.0.115",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "vite": "^7.3.1"
  }
}
