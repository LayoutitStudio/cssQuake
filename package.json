{
  "name": "cssquake",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "description": "A standalone CSS-rendered Quake renderer powered by PolyCSS.",
  "license": "GPL-2.0-only",
  "scripts": {
    "dev": "vite",
    "dev:trace": "vite --host 127.0.0.1 --port 5177",
    "prebuild": "pnpm exec playwright install chromium --only-shell",
    "prepare:quake": "node src/prepare/assets.mjs",
    "prepare:quake-logic": "node src/prepare/quakecLogic.mjs",
    "smoke:monster-combat": "node scripts/smokeMonsterCombat.mjs",
    "smoke:monster-dom": "node scripts/smokeDomMonsters.mjs",
    "build": "pnpm prepare:quake && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@layoutit/polycss": "^0.2.2",
    "nipplejs": "^1.0.4"
  },
  "devDependencies": {
    "7z-bin": "^0.0.8",
    "@types/node": "^25.5.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.58.2",
    "sharp": "^0.34.5",
    "vite": "^7.3.1"
  }
}
