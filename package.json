{
  "name": "cssquake",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "description": "A standalone CSS-rendered Quake renderer powered by PolyCSS.",
  "license": "GPL-2.0-only",
  "scripts": {
    "dev": "vite",
    "dev:trace": "vite --host 127.0.0.1 --port 5177",
    "prepare:quake": "node src/prepare/assets.mjs",
    "prepare:quake:map": "node src/prepare/target.mjs map",
    "prepare:quake:manifest": "QUAKE_PREPARE_ONLY=manifest node src/prepare/assets.mjs",
    "prepare:quake:model": "node src/prepare/target.mjs model",
    "prepare:quake-logic": "node src/prepare/quakecLogic.mjs",
    "prepare:quake-model-facts": "node src/prepare/modelRenderCostFacts.mjs",
    "build": "vite build",
    "build:full": "pnpm prepare:quake && vite build",
    "preview": "vite preview",
    "test": "node scripts/testContracts.mjs",
    "test:assets": "node scripts/testAssetIntegrity.mjs",
    "test:browser": "node scripts/testBrowser.mjs --full",
    "test:multiplayer": "node scripts/smokeMultiplayerLoopback.mjs",
    "test:multiplayer:party": "node scripts/smokeMultiplayerParty.mjs",
    "test:perf": "node scripts/testPerf.mjs",
    "test:all": "pnpm build && pnpm test && pnpm test:assets && pnpm test:multiplayer && pnpm test:multiplayer:party && node scripts/testBrowser.mjs"
  },
  "dependencies": {
    "@layoutit/polycss": "^0.2.6",
    "nipplejs": "^1.0.4",
    "partysocket": "1.1.19"
  },
  "devDependencies": {
    "7z-bin": "^0.0.8",
    "@napi-rs/canvas": "^1.0.0",
    "@types/node": "^25.5.0",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.10.2",
    "partykit": "0.0.115",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "vite": "^7.3.1"
  }
}
